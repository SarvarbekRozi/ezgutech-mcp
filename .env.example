# ═══ Rejim ══════════════════════════════════════════════════════════════════
# http  — claude.ai custom connector (OAuth, har xodim o'z hisobi bilan kiradi)
# stdio — Claude Code / Claude Desktop (bitta foydalanuvchi, pastdagi login)
XPERT_TRANSPORT=http

# ═══ Majburiy (ikkala rejimda) ═══════════════════════════════════════════════
XPERT_API_URL=https://api.ezgutech.uz/api/v1
# Lokal backend bilan sinash uchun:
# XPERT_API_URL=http://127.0.0.1:8000/api/v1

# ═══ http rejimi ═════════════════════════════════════════════════════════════
# Serverning INTERNETDAN ko'rinadigan manzili. OAuth metadata va redirect
# aynan shu manzilga tayanadi — xato bo'lsa claude.ai ulanmaydi.
#
# cloudflared tunnel bilan sinaganda tunnel bergan manzil:
#   XPERT_PUBLIC_URL=https://xxxx-yyyy.trycloudflare.com
# Doimiy deploy'da:
#   XPERT_PUBLIC_URL=https://mcp.ezgutech.uz
XPERT_PUBLIC_URL=

# Server tinglaydigan port (proxy orqasida ichki port)
PORT=8788

# Oldida nechta ishonchli proxy turadi (nginx / cloudflared → 1).
# `true` emas, aniq son: soxta X-Forwarded-For bilan rate-limit chetlab
# o'tilmasligi uchun.
TRUST_PROXY_HOPS=1

# OAuth token muddatlari (soniya).
# EzguTech JWT 6 soat yashaydi; access token muddati o'tganda refresh orqali
# avtomatik yangilanadi, foydalanuvchi buni sezmaydi.
XPERT_ACCESS_TOKEN_TTL_SEC=3600
XPERT_REFRESH_TOKEN_TTL_SEC=2592000

# ═══ stdio rejimi ════════════════════════════════════════════════════════════
# Faqat XPERT_TRANSPORT=stdio bo'lganda kerak.
# Ruxsatlar shu foydalanuvchi bo'yicha amal qiladi — umumiy "servis" hisobi
# ISHLATMANG, aks holda har kim hamma filialning ma'lumotini ko'radi.
XPERT_LOGIN=
XPERT_PASSWORD=

# ═══ Yuklamani cheklash (ikkala rejimda) ═════════════════════════════════════
# Bir xil so'rov shu muddat ichida takrorlansa API'ga bormaydi (ms).
# Kesh kaliti foydalanuvchi bo'yicha ajratilgan.
XPERT_CACHE_TTL_MS=90000

# Rate limit: HAR FOYDALANUVCHI uchun oynadagi maksimal so'rov soni
XPERT_RATE_LIMIT_MAX=20
XPERT_RATE_LIMIT_WINDOW_MS=60000

# Bitta EzguTech API so'rovi uchun timeout (ms)
XPERT_TIMEOUT_MS=30000

# Sana oralig'ining maksimal uzunligi (kun).
# Modelni butun yilni bitta og'ir so'rovda so'rashdan to'xtatadi.
XPERT_MAX_RANGE_DAYS=366

# Ro'yxat qaytaradigan tool'lar uchun maksimal qator soni
XPERT_MAX_ROWS=50

# EzguTech CRM "Integratsiyalar" sahifasi ulanish holatini so'raydigan manzillar.
# GET /connection-status faqat shu origin'lardan brauzer orqali chaqiriladi.
# Vergul bilan ajratiladi. Bo'sh bo'lsa CRM holatni aniqlay olmaydi va
# foydalanuvchi uni qo'lda belgilaydi.
XPERT_STATUS_ORIGINS=https://crm.ezgutech.uz
